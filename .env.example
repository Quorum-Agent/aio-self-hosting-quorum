# Server
HOST=127.0.0.1
PORT=8787
LOG_LEVEL=info
QUORUM_DATA_DIR=./var

# Optional trusted-LAN development password. `npm run dev:network` generates a
# short random pairing code when this is unset, which is the safer default.
# Invent your own phrase of at least 24 characters; never copy this example.
# QUORUM_DEV_NETWORK_PASSWORD=<invent-your-own-phrase-here>

# How many models answer one request.
#   route (default) — one model answers directly. Lowest latency, and the whole
#     VRAM budget goes to a single model, so that model can be the largest one
#     your card holds.
#   relay — a specialist drafts and the general model rewrites it, so answers
#     read in one voice whichever specialist ran. Costs a second inference and
#     keeps two models resident, which caps how large the specialist can be.
# QUORUM_ORCHESTRATION_MODE=route

# Local OpenAI-compatible endpoint (Ollama works with this default URL)
QUORUM_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
QUORUM_LOCAL_MODEL=qwen3.5:9b
QUORUM_LOCAL_PROMPT_MODEL=qwen3.5:2b
QUORUM_LOCAL_API_KEY=ollama
QUORUM_LOCAL_TRANSPORT=ollama
QUORUM_LOCAL_CONTEXT_WINDOW=16384
QUORUM_LOCAL_PROMPT_CONTEXT_WINDOW=4096
QUORUM_LOCAL_WARMUP=true

# Experimental Quorum-managed llama.cpp runtime. The executable and model
# weights remain separate, interchangeable files. When enabled, this endpoint
# replaces QUORUM_LOCAL_BASE_URL for the current Quorum process.
# Copy config/managed-models.example.json to config/managed-models.local.json,
# select the stable logical IDs below, and point each entry at a local GGUF.
# QUORUM_MANAGED_LLAMA_SERVER=C:/Quorum/runtime/llama-server.exe
# QUORUM_MANAGED_LLAMA_MODELS=./config/managed-models.local.json
# QUORUM_MANAGED_LLAMA_STARTUP_TIMEOUT_MS=180000
# QUORUM_LOCAL_PROMPT_MODEL=quorum-prompt
# QUORUM_LOCAL_MODEL=quorum-main

# Optional user-facing specialists. Leave unset until a candidate has been
# evaluated for your workload; the main model handles these capabilities by default.
# QUORUM_LOCAL_CODING_MODEL=
# QUORUM_LOCAL_CODING_CONTEXT_WINDOW=16384
# QUORUM_LOCAL_REASONING_MODEL=
# QUORUM_LOCAL_REASONING_CONTEXT_WINDOW=16384

# Optional model on another machine you run, on your own network. Leaves this
# device but not your network, and you control the stack at both ends - which
# is why it is a separate tier from cloud rather than a variant of it.
# The address must be private (RFC1918, link-local, CGNAT, or a .local/.lan/
# .internal/.home name); plain HTTP is permitted there and nowhere further out.
# Not registered without a key: a peer that answers unauthenticated is one
# anyone on the network can impersonate.
# QUORUM_NETWORK_BASE_URL=http://192.168.1.50:8787/v1
# QUORUM_NETWORK_MODEL=
# QUORUM_NETWORK_API_KEY=
# QUORUM_NETWORK_CONTEXT_WINDOW=16384
# QUORUM_NETWORK_QUALITY_RATING=70

# Optional cloud fallback. The provider is not registered without a key.
QUORUM_CLOUD_BASE_URL=https://api.openai.com/v1
QUORUM_CLOUD_MODEL=gpt-4.1-mini
QUORUM_CLOUD_API_KEY=
# Set these to the configured provider/model's real limits and relative quality.
# QUORUM_CLOUD_CONTEXT_WINDOW=128000
# QUORUM_CLOUD_QUALITY_RATING=80

# Web search is enabled by default in Auto mode. Auto tries configured providers
# in this order: Exa, Perplexity, Tavily, Brave, Firecrawl, SearXNG, then the
# keyless DuckDuckGo fallback. These values can also be changed in Settings.
# false is an operator kill switch and cannot be overridden by saved UI settings.
# QUORUM_WEB_SEARCH_ENABLED=true
# QUORUM_WEB_SEARCH_PROVIDER=auto
# QUORUM_WEB_SEARCH_RESULT_LIMIT=5
#
# Optional keyed providers
# QUORUM_EXA_SEARCH_API_KEY=
# QUORUM_PERPLEXITY_SEARCH_API_KEY=
# QUORUM_TAVILY_SEARCH_API_KEY=
# QUORUM_BRAVE_SEARCH_API_KEY=
# QUORUM_FIRECRAWL_SEARCH_API_KEY=
#
# Optional loopback SearXNG instance with JSON output enabled
# QUORUM_WEB_SEARCH_PROVIDER=searxng
# QUORUM_SEARXNG_BASE_URL=http://127.0.0.1:8080

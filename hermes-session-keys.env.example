# Session-bus secret store — TEMPLATE (committed).
#
# Copy to hermes-session-keys.env (gitignored) and fill in the live Hermes
# session keys for each window you coordinate. These are runtime secrets:
# anyone holding SB1's key can wake SB1 from another window. Never commit
# the populated file.
#
# How to get a value: in the target window, run
#   import os; print(os.environ.get("HERMES_SESSION_KEY") or os.environ.get("HERMES_UI_SESSION_ID", ""))
# and paste the printed string below.
#
# Empty values are intentional here. The loader (scripts/load-session-keys.sh)
# exports these into the agent process environment so a notify_on_complete
# launch can be pre-targeted at the named window (see docs/intended-features.md
# IF-001 and the session-bus-injection skill).

# Live key for Support Session - Background Agent 1 (SB1)
SB1_SESSION_KEY=

# Live key for Support Session - Background Agent 2 (SB2)
SB2_SESSION_KEY=

# Live key for the orchestrator / main Quorum window
ORCH_SESSION_KEY=

# API Key for local Quorum development API authentication
QUORUM_LOCAL_API_KEY=

# API Key for the local model server (e.g. Ollama). Separate from
# QUORUM_LOCAL_API_KEY to avoid conflating Quorum's own API auth with
# the model server's auth.
QUORUM_LOCAL_MODEL_API_KEY=
